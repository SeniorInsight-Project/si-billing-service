# Copie para .env e preencha. O .env não é versionado.

# PostgreSQL (o Flyway cria o schema "billing" se ele não existir)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=billing
DB_PASSWORD=

# RabbitMQ (o serviço declara a exchange topic "si.events", a fila "billing.q" e a dead-letter "billing.dlq")
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=billing
RABBITMQ_PASSWORD=

# Keycloak: precisa ser igual ao claim "iss" dos tokens
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight
# Opcional: de onde baixar as chaves públicas quando o issuer não é acessível pelo serviço (ex.: no Docker Compose)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://keycloak:8080/realms/seniorinsight/protocol/openid-connect/certs

# Porta HTTP do serviço
SERVER_PORT=8080
